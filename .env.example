# Multilingual Sentiment & Feedback Analytics for Indian Languages
# Configuration Environment Variables

PROJECT_NAME="Multilingual Sentiment and Feedback Analytics for Indian Languages"
VERSION="1.0.0"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLAlchemy 2.x SQLite)
DATABASE_URL="sqlite:///./sentiment.db"

# Hugging Face Transformer Model
MODEL_NAME="cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual"

# Development / Offline Mock Flag (1 = bypass transformer download, 0 = production)
FAST_NLP=0
